# ==============================================================================
# Simplicity EOD Excel Updater - Environment Variables Reference (.env.example)
# ==============================================================================

# 1. SharePoint Online Sharing Link (Anyone with the link can view / guest URL)
# If provided, the app automatically pulls the live Effort Tracker on startup and page load!
EOD_SHAREPOINT_URL=https://psiog0-my.sharepoint.com/:x:/g/personal/abinayasundari_paramasivam_psiog_com/IQCajkhcEzfESIEMXT6hpb0NAY5Z6-iujcXYrEnq0Z27shA?e=yvkpjj

# 2. Resend API Key (for Cloud Email Automation triggering Power Automate)
# Free tier from https://resend.com
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE
RESEND_TO_EMAIL=aravindhan.chandrasekaran@psiog.com
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_SUBJECT=[EOD-UPDATE]

# 3. Optional Power Automate Cloud Webhook (HTTP Request trigger)
POWER_AUTOMATE_WEBHOOK_URL=

# 4. Server Port (Default: 8080)
PORT=8080
